# Copy to .env. Every setting is optional; see src/hybrid_rag/config.py for all of them.

# Enables Claude-generated, cited answers. Without it the app uses an extractive fallback.
ANTHROPIC_API_KEY=

# Use a Qdrant server instead of the embedded on-disk index in data/qdrant.
# RAG_QDRANT_URL=http://localhost:6333

# RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RAG_CANDIDATE_K=50
# RAG_RERANK_DEPTH=30
# RAG_LLM_MODEL=claude-opus-5-5
# RAG_LLM_EFFORT=low
